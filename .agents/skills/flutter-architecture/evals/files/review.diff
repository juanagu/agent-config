+++ b/lib/src/features/edit_profile/data/remote/ProfileRepositoryImpl.dart
@@ -0,0 +1,26 @@
+import 'package:cloud_firestore/cloud_firestore.dart';
+import 'package:firebase_auth/firebase_auth.dart';
+import '../../domain/repositories/profile_repository.dart';
+
+class ProfileRepositoryImpl implements ProfileRepository {
+  Future<void>? _ready;
+
+  Future<void> _init() async {
+    await FirebaseFirestore.instance.enableNetwork();
+  }
+
+  @override
+  Future<Map<String, dynamic>> load() async {
+    _ready ??= _init();
+    await _ready;
+    final uid = FirebaseAuth.instance.currentUser!.uid;
+    final snap = await FirebaseFirestore.instance.doc('users/$uid').get();
+    return snap.data()!;
+  }
+
+  @override
+  Future<void> save(String displayName, String bio) async {
+    final uid = FirebaseAuth.instance.currentUser!.uid;
+    await FirebaseFirestore.instance.doc('users/$uid').update({'displayName': displayName, 'bio': bio});
+  }
+}
diff --git a/lib/src/features/edit_profile/presentation/cubits/edit_profile_cubit.dart b/lib/src/features/edit_profile/presentation/cubits/edit_profile_cubit.dart
