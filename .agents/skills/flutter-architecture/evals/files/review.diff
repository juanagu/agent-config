+++ b/lib/src/features/edit_profile/presentation/cubits/edit_profile_cubit.dart
@@ -0,0 +1,21 @@
+import 'dart:async';
+import 'package:flutter_bloc/flutter_bloc.dart';
+import '../../domain/repositories/profile_repository.dart';
+
+class EditProfileCubit extends Cubit<String> {
+  EditProfileCubit(this._repo) : super('idle');
+  final ProfileRepository _repo;
+  final _changes = StreamController<String>.broadcast();
+  Stream<String> get changes => _changes.stream;
+
+  Future<void> save(String name, String bio) async {
+    emit('saving');
+    try {
+      await _repo.save(name, bio);
+      _changes.add(name);
+      emit('saved');
+    } catch (e) {
+      emit('error');
+    }
+  }
+}
