+import 'package:flutter/material.dart';
+import 'package:flutter_bloc/flutter_bloc.dart';
+import '../cubits/edit_profile_cubit.dart';
+
+class EditProfilePage extends StatelessWidget {
+  const EditProfilePage({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final name = TextEditingController();
+    final bio = TextEditingController();
+    return Scaffold(
+      appBar: AppBar(title: const Text('Edit profile')),
+      body: BlocBuilder<EditProfileCubit, String>(
+        builder: (context, state) {
+          if (state == 'saving') return const Center(child: CircularProgressIndicator());
+          return Column(children: [
+            TextField(controller: name),
+            TextField(controller: bio),
+            if (state == 'error') const Text('Something went wrong', style: TextStyle(color: Color(0xFFE4572E))),
+            ElevatedButton(
+              onPressed: () => context.read<EditProfileCubit>().save(name.text, bio.text),
+              child: const Text('Save'),
+            ),
+          ]);
+        },
+      ),
+    );
+  }
+}
