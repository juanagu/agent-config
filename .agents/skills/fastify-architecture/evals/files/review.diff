+import type { Db } from "mongodb";
+
+// Shared so invites and workspaces can both count seats without a hop.
+export class MongoSeatUsageRepository {
+  constructor(private readonly db: Db) {}
+
+  async countActive(workspaceId: string): Promise<number> {
+    return this.db.collection("seat_usage").countDocuments({ workspaceId, active: true });
+  }
+}
