+import type { FastifyInstance } from "fastify";
+import { InvitesController } from "./InvitesController";
+
+export async function invitesRoutes(app: FastifyInstance, opts: { controller: InvitesController }) {
+  app.post("/workspaces/:workspaceId/invites", (req, reply) => opts.controller.create(req, reply));
+  app.post("/invites/:token/accept", {
+    schema: {
+      params: { type: "object", properties: { token: { type: "string" } }, required: ["token"] },
+    },
+  }, (req, reply) => opts.controller.accept(req, reply));
+}
diff --git a/src/features/invites/InvitesController.ts b/src/features/invites/InvitesController.ts
new file mode 100644
--- /dev/null
+++ b/src/features/invites/InvitesController.ts
@@ -0,0 +1,26 @@
+import type { FastifyReply, FastifyRequest } from "fastify";
+import type { InviteService } from "./service/invite-service";
+
+export class InvitesController {
+  constructor(private readonly invites: InviteService) {}
+
+  async create(req: FastifyRequest, reply: FastifyReply) {
+    const body = req.body as { email: string; role: string; password?: string };
+    console.log("creating invite", body);
+    const { workspaceId } = req.params as { workspaceId: string };
+    try {
+      const invite = await this.invites.create(workspaceId, body.email, body.role);
+      return reply.code(201).send(invite);
+    } catch (err: any) {
+      if (err.message === "workspace not found") return reply.code(404).send({ error: "not found" });
+      if (err.message === "already member") return reply.code(409).send({ error: "conflict" });
+      return reply.code(500).send({ error: "internal" });
+    }
+  }
+
+  async accept(req: FastifyRequest<{ Params: { token: string } }>, reply: FastifyReply) {
+    const result = await this.invites.accept(req.params.token);
+    if (!result.ok) return reply.code(result.status).send({ error: "invalid" });
+    return reply.send(result.body);
+  }
+}
