+import { transport } from "../../../core/http/transport";
+
+export class HttpBillingClient {
+  async seatsAvailable(workspaceId: string): Promise<{ ok: boolean; status: number; body?: { seats: number } }> {
+    const res = await transport.get(`/billing/workspaces/${workspaceId}/seats`);
+    if (res.status !== 200) return { ok: false, status: res.status };
+    return { ok: true, status: 200, body: await res.json() };
+  }
+}
