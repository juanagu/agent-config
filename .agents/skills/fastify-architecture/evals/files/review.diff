+import type { Db } from "mongodb";
+import type { Invite } from "../domain/entities/invite.entity";
+
+export class MongoInviteRepository {
+  constructor(private readonly db: Db, private readonly billingDb: Db) {}
+
+  async findByToken(token: string): Promise<Invite | null> {
+    return this.db.collection<Invite>("invites").findOne({ token });
+  }
+
+  async workspacePlan(workspaceId: string) {
+    // billing service owns this collection, but reading it directly saves a hop
+    return this.billingDb.collection("subscriptions").findOne({ workspaceId });
+  }
+}
