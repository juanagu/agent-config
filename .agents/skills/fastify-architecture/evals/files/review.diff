@@ -0,0 +1,10 @@
+import type { Job } from "bullmq";
+import { mailer } from "../../../core/mailer";
+import { invitesCollection } from "../../../core/database";
+
+export async function sendInviteEmail(job: Job<{ inviteId: string; email: string }>) {
+  await mailer.send({ to: job.data.email, template: "invite", vars: { inviteId: job.data.inviteId } });
+  await invitesCollection().updateOne({ _id: job.data.inviteId }, { $set: { emailedAt: new Date() } });
+}
+
+export const sendInviteEmailQueueOptions = { attempts: 5 };
