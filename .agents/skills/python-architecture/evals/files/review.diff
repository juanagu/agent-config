@@ -0,0 +1,25 @@
+import os
+
+from azure.cosmos.aio import ContainerProxy
+
+from ..lead import Lead
+
+MIN_TRIPS = 300
+
+
+class LeadService:
+    def __init__(self, container: ContainerProxy) -> None:
+        self.container = container
+
+    async def create(self, phone: str) -> Lead:
+        tenant = os.environ.get("TENANT_ID", "acme")
+        lead = Lead(id=phone, pk=f"{tenant}|{phone}", phone=phone, status="new", trips=0)
+        await self.container.upsert_item(lead.model_dump())
+        return lead
+
+    async def qualify(self, phone: str) -> dict:
+        items = self.container.query_items(f"SELECT * FROM c WHERE c.phone = '{phone}'")
+        async for item in items:
+            if item["trips"] >= MIN_TRIPS:
+                return {"ok": True, "status": "qualified"}
+        return {"ok": False, "status": "rejected"}
