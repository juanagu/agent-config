+import requests
+
+
+class CrmClient:
+    async def find_application(self, phone: str) -> dict:
+        response = requests.get(f"https://crm.example.com/applications?phone={phone}")
+        if response.status_code != 200:
+            return {"ok": False, "status": response.status_code}
+        return {"ok": True, "body": response.json()}
