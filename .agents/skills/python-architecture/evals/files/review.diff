@@ -0,0 +1,17 @@
+from dataclasses import dataclass
+
+from leads_api.features.leads.data.cosmos_lead_repository import CosmosLeadRepository
+
+
+@dataclass(frozen=True, slots=True)
+class ScoreLeadInput:
+    phone: str
+
+
+class ScoreLeadUseCase:
+    def __init__(self, leads: CosmosLeadRepository) -> None:
+        self._leads = leads
+
+    async def execute(self, command: ScoreLeadInput) -> int:
+        lead = await self._leads.get(command.phone)
+        return lead.trips // 10
