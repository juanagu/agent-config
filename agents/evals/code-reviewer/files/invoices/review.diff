@@ -0,0 +1,22 @@
+import type { FastifyInstance } from 'fastify'
+import { listInvoices } from "./list-invoices";
+import type { InvoiceRepository } from "./invoice-repository";
+
+export async function invoicesRoutes(app: FastifyInstance, opts: { repo: InvoiceRepository }) {
+  app.get("/accounts/:accountId/invoices", {
+    schema: {
+      params: { type: "object", properties: { accountId: { type: "string" } }, required: ["accountId"] },
+      querystring: {
+        type: "object",
+        properties: {
+          page: { type: "integer", minimum: 1, default: 1, description: "1-based page number" },
+          pageSize: { type: "integer", minimum: 1, maximum: 100 },
+        },
+      },
+    },
+  }, async (req) => {
+    const { accountId } = req.params as { accountId: string };
+    const { page, pageSize } = req.query as { page: number; pageSize?: number };
+    return listInvoices(opts.repo, { accountId, page, pageSize });
+  })
+}
