@@ -0,0 +1,16 @@
+import { describe, expect, it } from "vitest";
+import { listInvoices } from "./list-invoices";
+
+const makeRepo = (count: number) => ({
+  findByAccount: async (_id: string, { skip, limit }: { skip: number; limit: number }) =>
+    Array.from({ length: count }, (_, i) => ({ id: `inv-${i + 1}` })).slice(skip, skip + limit),
+  countByAccount: async () => count,
+});
+
+describe("listInvoices", () => {
+  it("returns the second page", async () => {
+    const res = await listInvoices(makeRepo(45) as never, { accountId: "a1", page: 2 });
+    expect(res.items[0]?.id).toBe("inv-41");
+    expect(res.total).toBe(45);
+  });
+});
